# Normalize line endings in the repo; keep LF for files used inside Linux containers.
* text=auto
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.env.example text eol=lf

# Binary files
*.png binary
*.jpg binary
*.parquet binary
*.joblib binary
