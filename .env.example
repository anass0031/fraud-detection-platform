# Copy this file to .env and adjust values. .env is never committed.

# --- PostgreSQL ---
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me-local-only

# --- Host ports (change if one is already in use) ---
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# --- Backend ---
# Inside Docker the backend reaches the database by its service name "db" on port 5432.
DATABASE_URL=postgresql+psycopg://fraud:change-me-local-only@db:5432/fraud
ENVIRONMENT=development

# --- Authentication ---
# Secret used to sign access tokens (at least 32 characters). Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret

# --- Demo users (created by: docker compose exec backend python -m app.scripts.seed_users) ---
# Choose your own passwords (10+ characters). The seed script refuses the placeholders.
SEED_ADMIN_EMAIL=admin@fraud.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ANALYST_PASSWORD=change-me-analyst-password
